<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Without this the device never registers with APNs, FIRMessaging.APNSToken
	     stays nil and getToken() throws apns-token-not-set, so no iOS push can
	     ever be delivered. Xcode rewrites this to "production" for a release
	     archive when the provisioning profile allows it. -->
	<key>aps-environment</key>
	<string>development</string>
</dict>
</plist>
